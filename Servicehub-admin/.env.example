# ServiHub admin app configuration. Copy to .env.
# Vite bakes these in at build time, so rebuild after changing them.

# The API's full URL, including /api. Its origin is also used for Socket.IO,
# and this app's origin must be listed in the API's CLIENT_URL.
VITE_API_URL=http://localhost:5000/api

# Or leave VITE_API_URL unset to call /api on this app's own origin. The host
# then has to forward /api and /socket.io to the API: vercel.json does that on
# Vercel, and `npm run dev` forwards them to http://localhost:5000. Realtime
# updates use HTTP long-polling in that setup, as the forwarding doesn't carry
# WebSockets.

# Everything else (demo mode, Google sign-in client id, AI/email availability,
# the service catalogue) comes from the API at runtime via GET /api/config.
