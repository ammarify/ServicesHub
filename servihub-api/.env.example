# ServiHub API configuration. Copy to .env and fill in the values.
# Every variable is validated at boot (src/config/env.js); the API refuses to
# start with a clear message if a required one is missing or malformed.

# --- Required -------------------------------------------------------------

# development | test | production. Production turns on Secure cookies,
# hides stack traces and switches DEMO_MODE off unless it is set below.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local server, Docker or MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/servihub

# Origin(s) of the admin app, comma-separated. Only these may call the API
# from a browser (REST and Socket.IO). The first one is also used to build
# password-reset and invitation links.
CLIENT_URL=http://localhost:5173

# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Sessions (optional) --------------------------------------------------

# Access-token lifetime. The admin app refreshes silently when it runs out;
# lower it (e.g. 30s) to watch that happen.
ACCESS_TOKEN_TTL=15m
# Session length with "Keep me logged in" ticked (sliding: every refresh
# extends it) ...
REFRESH_TOKEN_TTL=30d
# ... and without it. Those cookies also end when the browser closes.
SESSION_TOKEN_TTL=12h

# Cookie scope. "lax" works when the admin app and API share a site
# (localhost:5173 + localhost:5000, app.example.com + api.example.com).
# Hosting them on unrelated domains needs "none" (HTTPS only).
COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .example.com to share across subdomains.
COOKIE_DOMAIN=

# --- Integrations (optional; each feature reports itself as off without) ---

# AI Copilot (https://console.groq.com/keys). Leave GROQ_MODEL blank for the
# default (openai/gpt-oss-120b). Groq retires models now and then
# (https://console.groq.com/docs/deprecations); "npm run check:ai" tests the
# key and the model.
GROQ_API_KEY=
GROQ_MODEL=

# "Sign in with Google" for existing staff (Google Cloud OAuth client id).
GOOGLE_CLIENT_ID=

# Password-reset and invitation emails via Resend (https://resend.com).
# Without a key, development prints each email (with its link) to the API
# console, and invitations show the link to the inviting admin.
RESEND_API_KEY=
EMAIL_FROM=ServiHub <onboarding@resend.dev>
# Base URL for reset/invite links. Defaults to <first CLIENT_URL>/reset-password.
RESET_PASSWORD_URL_BASE=

# --- Behaviour (optional) -------------------------------------------------

# Password-less demo login on the sign-in page and the public customer
# simulator. Defaults to on outside production and off in production.
DEMO_MODE=

# Business time zone for dashboard periods when the browser doesn't send one.
APP_TIMEZONE=America/Chicago

# Number of reverse proxies in front of the API (Render, Railway, nginx...),
# so rate limits see real client IPs. 0 when the API is reached directly.
TRUST_PROXY=0

# Turns every rate limiter off. Only for automated test runs.
DISABLE_RATE_LIMITS=false
